<UserControl x:Class="ProRandevu.App.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <Button Content="Yeni Personel" Command="{Binding NewCommand}" DockPanel.Dock="Top" Margin="0,0,0,5" />
            <DataGrid ItemsSource="{Binding StaffList}"
                      SelectedItem="{Binding SelectedStaff, Mode=TwoWay}"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ad" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Uzmanlık" Binding="{Binding Expertise}" />
                    <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <Label Content="Ad" />
            <TextBox Text="{Binding SelectedStaff.Name, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="Uzmanlık" />
            <TextBox Text="{Binding SelectedStaff.Expertise, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Content="Aktif" IsChecked="{Binding SelectedStaff.IsActive, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button Content="Kaydet" Command="{Binding SaveCommand}" Margin="0,0,5,0" />
                <Button Content="Sil" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
