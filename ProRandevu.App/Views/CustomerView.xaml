<UserControl x:Class="ProRandevu.App.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <Button Content="Yeni Müşteri" Command="{Binding NewCommand}" DockPanel.Dock="Top" Margin="0,0,0,5" />
        <DataGrid ItemsSource="{Binding Customers}"
                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  Height="200"
                  DockPanel.Dock="Top"
                  Margin="0,0,0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad" Binding="{Binding FirstName}" />
                <DataGridTextColumn Header="Soyad" Binding="{Binding LastName}" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" />
                <DataGridTextColumn Header="Doğum Tarihi" Binding="{Binding BirthDate, StringFormat=d}" />
                <DataGridTextColumn Header="Not" Binding="{Binding Note}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel>
            <Label Content="Ad" />
            <TextBox Text="{Binding SelectedCustomer.FirstName, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="Soyad" />
            <TextBox Text="{Binding SelectedCustomer.LastName, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="Telefon" />
            <TextBox Text="{Binding SelectedCustomer.Phone, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="Doğum Tarihi" />
            <DatePicker SelectedDate="{Binding SelectedCustomer.BirthDate, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="Not" />
            <TextBox Text="{Binding SelectedCustomer.Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" />
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button Content="Kaydet" Command="{Binding SaveCommand}" Margin="0,0,5,0" />
                <Button Content="Sil" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
